	"1": [".#.", "##.", ".#.", ".#.", ".#.", ".#.", "###"],
	"2": [".###.", "#...#", "....#", "...#.", "..#..", ".#...", "#####"],
	"3": ["####.", "....#", "....#", ".###.", "....#", "....#", "####."],
	"4": ["...#.", "..##.", ".#.#.", "#..#.", "#####", "...#.", "...#."],
	"5": ["#####", "#....", "####.", "....#", "....#", "#...#", ".###."],
	"6": [".###.", "#....", "#....", "####.", "#...#", "#...#", ".###."],
	"7": ["#####", "....#", "...#.", "..#..", ".#...", ".#...", ".#..."],
	"8": [".###.", "#...#", "#...#", ".###.", "#...#", "#...#", ".###."],
	"9": [".###.", "#...#", "#...#", ".####", "....#", "....#", ".###."],
	".": [".", ".", ".", ".", ".", ".", "#"],
	",": ["..", "..", "..", "..", "..", "..", ".#", "#."],
	"!": ["#", "#", "#", "#", "#", ".", "#"],
	"?": [".###.", "#...#", "....#", "...#.", "..#..", ".....", "..#.."],
	"-": ["....", "....", "....", "####", "....", "....", "...."],
	"+": [".....", "..#..", "..#..", "#####", "..#..", "..#..", "....."],
	"'": ["#", "#", ".", ".", ".", ".", "."],
	":": [".", ".", "#", ".", ".", "#", "."],
	"/": ["....#", "...#.", "...#.", "..#..", ".#...", ".#...", "#...."],
	"&": [".##..", "#..#.", "#.#..", ".#...", "#.#.#", "#..#.", ".##.#"],
	"♥": [".....", ".#.#.", "#####", "#####", ".###.", "..#..", "....."],
}

static var _cache := {}


## 一段文字排成的点（格子坐标，左上为原点、y 向下）：每个亮格一个点；相邻的两个亮格之间再补一个点，
## 斜着相邻（中间没有直接相连的格）也补一个，笔画更连贯
static func cells(text: String) -> PackedVector2Array:
	var lit := {}
	var x := 0
	for ch in text:
		if ch == " ":
			x += SPACE + 1
			continue
		var glyph: Array = GLYPHS.get(ch, GLYPHS["?"])
		var width := 0
		for row in glyph.size():
			var line: String = glyph[row]
			width = maxi(width, line.length())
			for col in line.length():
				if line[col] == "#":
					lit[Vector2i(x + col, row)] = true
		x += width + 1
	var out := PackedVector2Array()
	for c: Vector2i in lit:
		out.append(Vector2(c))
	for c: Vector2i in lit:
		for d: Vector2i in [Vector2i(1, 0), Vector2i(0, 1)]:
			if lit.has(c + d):
				out.append(Vector2(c) + Vector2(d) * 0.5)
		for d: Vector2i in [Vector2i(1, 1), Vector2i(-1, 1)]:
			if lit.has(c + d) and not lit.has(c + Vector2i(d.x, 0)) and not lit.has(c + Vector2i(0, d.y)):
				out.append(Vector2(c) + Vector2(d) * 0.5)
	return out


## 文字图案：点按文字的中心对齐，按半宽缩放到 -1 ~ 1（y 同样的比例，向下为正）
static func points(text: String) -> PackedVector2Array:
	if _cache.has(text):
		return _cache[text]
	var pts := cells(text)
	if pts.is_empty():
		_cache[text] = pts
		return pts
	var lo := pts[0]
	var hi := pts[0]
	for p in pts:
		lo = lo.min(p)
		hi = hi.max(p)
	var center := (lo + hi) * 0.5
	var half := maxf((hi.x - lo.x) * 0.5, 1.0)
	for i in pts.size():
		pts[i] = (pts[i] - center) / half
	_cache[text] = pts
	return pts
