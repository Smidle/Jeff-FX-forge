	"w": [".....", ".....", "#...#", "#...#", "#.#.#", "#.#.#", ".#.#."],
	"x": [".....", ".....", "#...#", ".#.#.", "..#..", ".#.#.", "#...#"],
	"y": [".....", ".....", "#...#", "#...#", "#...#", ".####", "....#", ".###."],
	"z": [".....", ".....", "#####", "...#.", "..#..", ".#...", "#####"],
